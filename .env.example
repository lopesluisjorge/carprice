# Copy to .env and adjust. Without a .env the settings already default to the
# Postgres in compose.yml, so a plain `docker compose up -d` needs no file here.

DATABASE_URL=postgres://carprice:carprice@127.0.0.1:5432/carprice

# SQLite is still supported and still exercised by the same test suite — this is
# the way to run it with no container at all:
# DATABASE_URL=sqlite:///db.sqlite3

# Only read by compose.yml, to change the container's own credentials/port.
# POSTGRES_DB=carprice
# POSTGRES_USER=carprice
# POSTGRES_PASSWORD=carprice
# POSTGRES_PORT=5432
