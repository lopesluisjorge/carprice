# Copy to .env and adjust. The same names are used in production, where systemd
# reads them from /etc/carprice/env instead of this file — see docs/deploy.md.
#
# DESENVOLVIMENTO: `cp .env.example .env` já basta. Sem esse arquivo o DEBUG
# nasce False e a aplicação se recusa a subir sem SECRET_KEY e ALLOWED_HOSTS,
# que é o comportamento desejado num servidor.

DEBUG=True

# Only read when DEBUG=False; in development the settings fall back to the
# insecure development key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# Comma-separated. Required when DEBUG=False. A leading dot is a subdomain
# wildcard: .carprice.com.br covers www.carprice.com.br.
# ALLOWED_HOSTS=carprice.com.br,www.carprice.com.br

# Derived from ALLOWED_HOSTS as https://<host> unless set here. Only needed when
# the scheme or port differs from that.
# CSRF_TRUSTED_ORIGINS=https://carprice.com.br

DATABASE_URL=postgres://carprice:carprice@127.0.0.1:5432/carprice

# SQLite is still supported and still exercised by the same test suite — this is
# the way to run it with no container at all:
# DATABASE_URL=sqlite:///db.sqlite3

# Seconds a database connection is reused. 0 in development, 60 in production.
# CONN_MAX_AGE=60

# collectstatic target. Defaults to ./staticfiles.
# STATIC_ROOT=/srv/carprice/staticfiles

# Single-worker lock of process_crawl_queue. Defaults to ./.crawl_queue.lock.
# CRAWL_QUEUE_LOCK_PATH=/run/carprice/crawl_queue.lock

# DEBUG, INFO, WARNING, ERROR. Default INFO.
# LOG_LEVEL=INFO

# --- HTTPS (only read when DEBUG=False) ---
# Turn the redirect off only while testing over plain HTTP.
# SECURE_SSL_REDIRECT=True
# HSTS starts at 0 on purpose. Ramp it up by hand once HTTPS is confirmed:
# 3600, then 86400, then a year. See docs/deploy.md.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Only read by compose.yml, to change the container's own credentials/port.
# POSTGRES_DB=carprice
# POSTGRES_USER=carprice
# POSTGRES_PASSWORD=carprice
# POSTGRES_PORT=5432
